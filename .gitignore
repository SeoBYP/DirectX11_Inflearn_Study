# ============================================================
#  Visual Studio / IDE 상태
# ============================================================
.vs/
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps

# ============================================================
#  빌드 중간 산출물 디렉터리
# ============================================================
[Dd]ebug/
[Rr]elease/
x64/
Win32/
Intermediate/
x64intermediate/
ipch/

# ============================================================
#  컴파일 / 링크 산출물
# ============================================================
*.obj
*.pch
*.ipch
*.ilk
*.idb
*.iobj
*.ipdb
*.pdb
*.exp
*.res
*.tlog
*.lastbuildstate
*.recipe
*.log
*.exe

# 셰이더 컴파일 결과 (원본은 Shaders/*.fx, Chapter*/*.hlsl)
# 런타임은 .fx / .hlsl 을 직접 읽으므로 .cso 는 산출물이다.
*.cso

# ============================================================
#  실행 시 생성되는 런타임 상태
# ============================================================
imgui.ini

# ============================================================
#  솔루션 출력 디렉터리
#  Binaries/ 는 전부 산출물이지만, assimp 런타임 DLL 은
#  이 폴더에만 존재하고 복사해 주는 빌드 단계가 없으므로 유지한다.
# ============================================================
**/Binaries/*
!**/Binaries/*.dll

# ============================================================
#  Engine 프로젝트가 빌드 중 생성하는 산출물
#  - Lib/Engine     : Engine.vcxproj 의 OutDir
#  - Include/Engine : Engine 빌드 후 post-build 이벤트가 헤더를 복사
#  서드파티(Assimp / DirectXTex / FX11)는 추적을 유지한다.
# ============================================================
**/Libraries/Lib/Engine/
**/Libraries/Include/Engine/
